# ---------------------------------------------------------------------------
# DevAI Hub - backend environment
# Copy to `.env` and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

APP_NAME=DevAI Hub
ENVIRONMENT=development
DEBUG=true

# Default: SQLite (no extra services required for personal / local use)
DATABASE_URL=sqlite+aiosqlite:///./devai_hub.db

# Optional PostgreSQL (uncomment if you have a local Postgres):
# DATABASE_URL=postgresql+asyncpg://devai:devai@localhost:5432/devai_hub

# Comma-separated list of allowed browser origins (not JSON)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

API_PREFIX=/api

# Admin API. Leave empty to disable every write endpoint entirely.
ADMIN_API_KEY=

# Pagination guard rails
DEFAULT_PAGE_SIZE=24
MAX_PAGE_SIZE=100

# Rate limiting (in-process; swap for Redis in production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Optional / future integrations (MVP works without all of these) ---
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=
