# ---------------------------------------------------------------------------
# DevAI Hub - backend environment
# Copy to `.env` for local use. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

APP_NAME=DevAI Hub
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Local default: SQLite (no extra services)
DATABASE_URL=sqlite+aiosqlite:///./devai_hub.db

# Optional PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/devai_hub

# Comma-separated browser origins (not JSON)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

API_PREFIX=/api
ADMIN_API_KEY=

DEFAULT_PAGE_SIZE=24
MAX_PAGE_SIZE=100

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Seed empty DBs on boot (enable on free hosts like Render)
AUTO_SEED=false

LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=
