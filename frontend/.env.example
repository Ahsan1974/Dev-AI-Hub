# Leave unset in local development: Vite proxies /api → backend :8000.
#
# Production (Vercel): set this to your live API base, including /api
# Example after Render deploy:
# VITE_API_BASE_URL=https://devai-hub-api.onrender.com/api

# VITE_API_BASE_URL=

# Backend origin used only by the Vite dev proxy
# VITE_API_PROXY=http://127.0.0.1:8000
